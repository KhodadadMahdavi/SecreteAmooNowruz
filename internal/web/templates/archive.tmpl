{{define "archive_page"}}
<h1>Archive</h1>
{{if .Years}}
  {{range .Years}}
  <section style="margin-bottom: 1.5rem;">
    <h2>{{.YearGregorian}} / {{.YearSolarHijri}}</h2>
    <ul>
      {{range .Games}}
      <li>
        <a href="{{.GameURL}}">{{.Title}}</a> - {{.EventDate}} - {{.Status}}
        - <a href="{{.AlbumURL}}">Album</a>
      </li>
      {{end}}
    </ul>
  </section>
  {{end}}
{{else}}
<p>No archived games yet.</p>
{{end}}

<p><a href="/dashboard">Back to dashboard</a></p>
{{end}}
