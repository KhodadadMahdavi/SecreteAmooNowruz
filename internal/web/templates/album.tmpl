{{define "album_page"}}
<section class="card">
  <h1 class="title-md">{{.GameTitle}} Album</h1>
  <p class="meta">Year: {{.YearGregorian}} / {{.YearSolarHijri}}</p>
  <div class="btn-row">
    <a class="btn secondary" href="/games/{{.GameID}}">Back to game</a>
  </div>
</section>

<section class="card">
  {{if .Photos}}
  <div class="photo-grid">
    {{range .Photos}}
    <figure>
      <img src="{{.ImageURL}}" alt="Album photo {{.ID}}">
      {{if .Caption}}<figcaption class="meta">{{.Caption}}</figcaption>{{end}}
    </figure>
    {{end}}
  </div>
  {{else}}
  <p class="muted">No photos uploaded yet.</p>
  {{end}}
</section>
{{end}}
