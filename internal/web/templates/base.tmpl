{{define "base"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}}</title>
  <style>
    :root {
      --bg: #f2f0e9;
      --card: #fffdf7;
      --ink: #1f1f1b;
      --muted: #6e6d64;
      --line: #ded9ca;
      --brand: #f7c500;
      --brand-ink: #12110d;
      --danger: #b00020;
      --ok: #0a7f3f;
      --radius: 18px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: radial-gradient(circle at 10% 10%, #fff8dd 0%, var(--bg) 50%, #ebe6d8 100%);
      color: var(--ink);
      font-family: "Avenir Next", "Trebuchet MS", "Gill Sans", sans-serif;
      min-height: 100vh;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .shell {
      width: 1100px;
      margin: 0 auto;
      padding: 28px 0 44px;
    }

    .topbar {
      background: #ffffffd6;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: 0 10px 25px #00000010;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 18px;
      margin-bottom: 20px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--brand-ink);
    }

    .brand-mark {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid #1f1f1b35;
      box-shadow: 0 8px 16px #0000001a;
      flex: 0 0 auto;
    }

    .brand-mark img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .brand-text {
      display: flex;
      flex-direction: column;
      line-height: 1.1;
    }

    .brand-text strong {
      letter-spacing: 0.3px;
      font-size: 1.06rem;
    }

    .brand-text small {
      color: var(--muted);
      font-size: 0.78rem;
      margin-top: 3px;
    }

    .topnav {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .topnav a {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 999px;
      color: #2a2924;
      font-size: 0.86rem;
      padding: 8px 13px;
      transition: background 120ms ease;
    }

    .topnav a:hover {
      background: #fff5cc;
    }

    .page-canvas {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: 0 10px 24px #0000000f;
      padding: 22px;
    }

    .title-lg {
      margin: 0 0 10px;
      font-size: 2rem;
      line-height: 1.1;
      letter-spacing: -0.01em;
    }

    .title-md {
      margin: 0 0 8px;
      font-size: 1.32rem;
      line-height: 1.2;
    }

    .muted {
      color: var(--muted);
    }

    .alert {
      border-radius: 12px;
      border: 1px solid;
      font-size: 0.95rem;
      padding: 10px 12px;
      margin: 0 0 14px;
    }

    .alert-error {
      color: var(--danger);
      border-color: #df9fb0;
      background: #fff4f6;
    }

    .alert-ok {
      color: var(--ok);
      border-color: #8dd7ae;
      background: #f0fff6;
    }

    .form-stack {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 10px;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .field label {
      font-size: 0.85rem;
      color: #33322d;
      font-weight: 600;
      letter-spacing: 0.01em;
    }

    .field input,
    .field textarea {
      border: 1px solid #cac4b2;
      border-radius: 12px;
      padding: 11px 12px;
      background: #fff;
      color: var(--ink);
      font: inherit;
    }

    .field textarea {
      resize: vertical;
      min-height: 90px;
    }

    .btn {
      display: inline-block;
      border: 1px solid #d9c064;
      border-radius: 12px;
      background: linear-gradient(#fcd849, var(--brand));
      color: #2a250f;
      font-weight: 700;
      letter-spacing: 0.01em;
      padding: 10px 15px;
      cursor: pointer;
      font-family: inherit;
    }

    .btn:hover {
      filter: brightness(1.02);
    }

    .btn.secondary {
      border: 1px solid var(--line);
      background: #fff;
      color: #2b2a24;
    }

    .btn-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 14px;
    }

    .grid-two {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .list-clean {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 10px;
    }

    .list-item {
      background: #fff;
      border: 1px solid #e5e0d1;
      border-radius: 14px;
      padding: 12px;
    }

    .meta {
      color: var(--muted);
      font-size: 0.87rem;
      margin-top: 5px;
    }

    .chip {
      display: inline-block;
      border-radius: 999px;
      border: 1px solid #d9d2bf;
      background: #f8f4e7;
      color: #4a473f;
      font-size: 0.75rem;
      padding: 3px 10px;
      margin-left: 6px;
    }

    .chip.good {
      background: #ecfff4;
      border-color: #9ddbb7;
      color: #196a3f;
    }

    .chip.warn {
      background: #fff8e6;
      border-color: #e4cb78;
      color: #7d640c;
    }

    .chip.bad {
      background: #fff1f3;
      border-color: #e7a7b5;
      color: #8f1f39;
    }

    .avatar {
      width: 128px;
      height: 128px;
      object-fit: cover;
      border-radius: 22px;
      border: 1px solid #dacfae;
      box-shadow: 0 10px 20px #00000014;
      background: #f7f5ef;
    }

    .photo-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 12px;
    }

    .photo-grid figure {
      margin: 0;
      padding: 10px;
      border-radius: 14px;
      border: 1px solid #e4decc;
      background: #fff;
    }

    .photo-grid img {
      width: 100%;
      height: 260px;
      object-fit: cover;
      border-radius: 10px;
      display: block;
    }

    .hero {
      display: grid;
      grid-template-columns: 1.6fr 1fr;
      gap: 16px;
      align-items: stretch;
    }

    .hero-mark {
      background: linear-gradient(145deg, #fff3b6, #fff);
      border: 1px solid #ebd68d;
      border-radius: var(--radius);
      min-height: 220px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero-mark .brand-mark {
      width: 190px;
      height: 190px;
      border-radius: 40px;
    }

    .footer-note {
      margin-top: 6px;
      text-align: center;
      color: var(--muted);
      font-size: 0.79rem;
      letter-spacing: 0.01em;
    }
  </style>
</head>
<body>
  <div class="shell">
    <header class="topbar">
      <a class="brand" href="/">
        <span class="brand-mark">
          <img src="/static/img/buzzybee-logo.png" alt="BuzzyBee logo">
        </span>
        <span class="brand-text">
          <strong>BuzzyBee Studio</strong>
          <small>{{.AppName}}</small>
        </span>
      </a>
      <nav class="topnav">
        <a href="/">Home</a>
        <a href="/dashboard">Dashboard</a>
        <a href="/archive">Archive</a>
        <a href="/admin">Admin</a>
      </nav>
    </header>

    <main class="page-canvas">
      {{if eq .Page "index_page"}}
        {{template "index_page" .}}
      {{else if eq .Page "signup_page"}}
        {{template "signup_page" .}}
      {{else if eq .Page "login_page"}}
        {{template "login_page" .}}
      {{else if eq .Page "dashboard_page"}}
        {{template "dashboard_page" .}}
      {{else if eq .Page "game_page"}}
        {{template "game_page" .}}
      {{else if eq .Page "admin_dashboard_page"}}
        {{template "admin_dashboard_page" .}}
      {{else if eq .Page "admin_new_game_page"}}
        {{template "admin_new_game_page" .}}
      {{else if eq .Page "admin_game_manage_page"}}
        {{template "admin_game_manage_page" .}}
      {{else if eq .Page "assignment_page"}}
        {{template "assignment_page" .}}
      {{else if eq .Page "album_page"}}
        {{template "album_page" .}}
      {{else if eq .Page "archive_page"}}
        {{template "archive_page" .}}
      {{end}}
    </main>

    <p class="footer-note">Crafted by BuzzyBee Studio</p>
  </div>
</body>
</html>
{{end}}
