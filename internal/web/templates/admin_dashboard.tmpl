{{define "admin_dashboard_page"}}
<section class="card">
  <h1 class="title-md">Admin Dashboard</h1>
  <p class="muted">Create and operate yearly game cycles from one place.</p>
  <div class="btn-row">
    <a class="btn" href="/admin/games/new">Create new game</a>
    <a class="btn secondary" href="/dashboard">Back to dashboard</a>
  </div>
</section>

<section class="card">
  <h2 class="title-md">Games</h2>
  {{if .Games}}
  <ul class="list-clean">
    {{range .Games}}
    <li class="list-item">
      <a href="/admin/games/{{.ID}}"><strong>{{.Title}}</strong></a>
      <div class="meta">({{.YearGregorian}} / {{.YearSolarHijri}}) - {{.EventDate}}</div>
      <div class="meta">
        status: {{.Status}}
        {{if .SignupOpen}}
          <span class="chip warn">signup open</span>
        {{else}}
          <span class="chip bad">signup closed</span>
        {{end}}
      </div>
    </li>
    {{end}}
  </ul>
  {{else}}
  <p class="muted">No games yet.</p>
  {{end}}
</section>
{{end}}
