{{define "admin_new_game_page"}}
<section class="card">
  <h1 class="title-md">Create Game</h1>
  <p class="muted">Define a new Secrete Amoo Nowruz cycle.</p>
  {{if .Error}}<p class="alert alert-error">{{.Error}}</p>{{end}}

  <form class="form-stack" method="post" action="/admin/games">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <div class="field">
      <label for="title">Title</label>
      <input id="title" name="title" type="text" required>
    </div>
    <div class="field">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="4"></textarea>
    </div>
    <div class="grid-two">
      <div class="field">
        <label for="year_gregorian">Gregorian Year</label>
        <input id="year_gregorian" name="year_gregorian" type="number" min="2000" max="2100" required>
      </div>
      <div class="field">
        <label for="year_solar_hijri">Solar Hijri Year</label>
        <input id="year_solar_hijri" name="year_solar_hijri" type="number" min="1300" max="1600" required>
      </div>
    </div>
    <div class="field">
      <label for="event_date">Event Date</label>
      <input id="event_date" name="event_date" type="date" required>
    </div>
    <div class="btn-row">
      <button class="btn" type="submit">Create Game</button>
      <a class="btn secondary" href="/admin">Back to admin dashboard</a>
    </div>
  </form>
</section>
{{end}}
